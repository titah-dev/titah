{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Titah configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "model": {
      "description": "Default model, in \"provider/model\" form. Nothing is guessed.",
      "type": "string"
    },
    "smallModel": {
      "description": "Cheap model for light work (session titles, compaction summaries)",
      "type": "string"
    },
    "provider": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Provider display name",
            "type": "string"
          },
          "npm": {
            "default": "@ai-sdk/openai-compatible",
            "description": "AI SDK package to use. openai-compatible is the default.",
            "type": "string",
            "enum": [
              "@ai-sdk/openai-compatible",
              "@ai-sdk/anthropic"
            ]
          },
          "options": {
            "type": "object",
            "properties": {
              "baseURL": {
                "description": "Endpoint base URL, e.g. https://host/v1",
                "type": "string"
              },
              "apiKey": {
                "description": "API key. Prefer `${env:VAR_NAME}` or auth.json — do not put plaintext here.",
                "type": "string"
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "includeUsage": {
                "default": true,
                "description": "Ask for token usage while streaming (stream_options.include_usage). Turn off if your endpoint rejects that field.",
                "type": "boolean"
              }
            },
            "description": "Options passed to the AI SDK provider factory"
          },
          "models": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "description": "Display name for this model",
                  "type": "string"
                },
                "contextWindow": {
                  "description": "Context window in tokens. Required for automatic compaction on this model.",
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "price": {
                  "description": "Price per 1M tokens. Declared, never guessed — `titah stats` reports unpriced models separately rather than counting them as free.",
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Per 1M input tokens"
                    },
                    "output": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Per 1M output tokens"
                    },
                    "cacheRead": {
                      "description": "Per 1M cached input tokens",
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "input",
                    "output"
                  ]
                }
              }
            }
          },
          "cacheControl": {
            "default": false,
            "description": "Send cache_control in the request body. Only for OpenAI-compatible gateways that forward it to Anthropic. Ask your gateway operator before turning this on.",
            "type": "boolean"
          }
        }
      }
    },
    "externalAgent": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Executable to invoke, e.g. \"claude\""
          },
          "specialist": {
            "description": "What this agent is best at, e.g. \"deep architectural reasoning, cross-module refactors\". Used by /tim to decide who gets which part.",
            "type": "string",
            "minLength": 1
          },
          "args": {
            "default": [],
            "description": "Arguments for the FIRST call. `{prompt}` and `{session}` are substituted.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resumeArgs": {
            "default": [],
            "description": "Arguments for resuming a session. Empty means reuse `args`.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sessionMode": {
            "default": "discover",
            "description": "\"generate\": Titah creates a UUID and hands it to the CLI (Claude Code style). \"discover\": the session id is read from the first call's output (opencode style).",
            "type": "string",
            "enum": [
              "generate",
              "discover"
            ]
          },
          "format": {
            "default": "stream-json",
            "description": "Output format expected from the CLI",
            "type": "string",
            "enum": [
              "stream-json",
              "json",
              "text"
            ]
          },
          "timeout": {
            "default": 600000,
            "description": "Timeout in milliseconds. Defaults to 10 minutes.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "command"
        ]
      }
    },
    "agent": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "description": "Shown in the agent picker",
            "type": "string"
          },
          "mode": {
            "default": "primary",
            "description": "Where this agent may run. \"primary\" is selectable with Tab; \"subagent\" can be dispatched by the coordinator; \"all\" is both.",
            "type": "string",
            "enum": [
              "primary",
              "subagent",
              "all"
            ]
          },
          "delegate": {
            "description": "Run this agent by spawning an external CLI from `externalAgent` instead of Titah's own loop. Mutually exclusive with `model`. Titah's `permission` block is NOT enforced on the external CLI, which applies its own policy — so a delegating agent always counts as a writer and is serialised with the other writers.",
            "type": "string"
          },
          "escalate": {
            "type": "object",
            "properties": {
              "to": {
                "type": "string",
                "description": "id di `externalAgent` yang boleh dimintai bantuan"
              },
              "when": {
                "type": "string",
                "minLength": 1,
                "description": "Kriteria, dalam kalimat. Mis. \"perubahan lintas modul, atau butuh memahami arsitektur dulu\""
              }
            },
            "required": [
              "to",
              "when"
            ]
          },
          "prompt": {
            "description": "Appended to the system prompt",
            "type": "string"
          },
          "model": {
            "description": "Model override, in \"provider/model\" form",
            "type": "string"
          },
          "effort": {
            "description": "How much closing analysis each answer ends with. Unset means no limit — the model decides. Cycle it live with ctrl+r.",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "steps": {
            "description": "Maximum agentic iterations for this agent before it is forced to answer in text",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "tools": {
            "default": {},
            "description": "Tool filter, e.g. {\"write\": false}. Tools not listed stay enabled.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "skills": {
            "default": [],
            "description": "Skill ids (\"namespace:name\", as listed by /skills) whose full content is loaded into this agent's system prompt. Bare names never match.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permission": {
            "description": "Permission override for this agent, on top of the global `permission`. This is what separates Build Auto from Build Manual.",
            "type": "object",
            "properties": {
              "edit": {
                "type": "string",
                "enum": [
                  "ask",
                  "allow",
                  "deny"
                ]
              },
              "write": {
                "type": "string",
                "enum": [
                  "ask",
                  "allow",
                  "deny"
                ]
              },
              "bash": {
                "type": "string",
                "enum": [
                  "ask",
                  "allow",
                  "deny"
                ]
              },
              "network": {
                "type": "string",
                "enum": [
                  "ask",
                  "allow",
                  "deny"
                ]
              },
              "delete": {
                "type": "string",
                "enum": [
                  "ask",
                  "allow",
                  "deny"
                ]
              },
              "mcp": {
                "type": "string",
                "enum": [
                  "ask",
                  "allow",
                  "deny"
                ]
              },
              "external_directory": {
                "type": "string",
                "enum": [
                  "deny",
                  "ask",
                  "allow"
                ]
              },
              "doom_loop": {
                "type": "string",
                "enum": [
                  "ask",
                  "allow",
                  "deny"
                ]
              },
              "rules": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "ask",
                    "allow",
                    "deny"
                  ]
                }
              },
              "allowlist": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "command": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "description": "Prompt template. `{{.Input}}` or `$ARGUMENTS` is replaced with the argument."
          },
          "description": {
            "type": "string"
          },
          "agent": {
            "description": "Agent that runs this command",
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "template"
        ]
      }
    },
    "skills": {
      "default": {
        "discover": [
          "claude",
          "opencode"
        ],
        "paths": [],
        "always": []
      },
      "type": "object",
      "properties": {
        "discover": {
          "default": [
            "claude",
            "opencode"
          ],
          "description": "Read Claude Code and opencode registries so installed skills work without configuration",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "opencode"
            ]
          }
        },
        "paths": {
          "default": [],
          "description": "Directories containing skills. Supports <dir>/<name>/SKILL.md and <dir>/<name>.md",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "as": {
                    "description": "Namespace override; derived from the folder when omitted",
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ]
              }
            ]
          }
        },
        "always": {
          "default": [],
          "description": "Skill ids loaded in full every turn, e.g. \"superpowers:using-superpowers\"",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "defaultAgent": {
      "description": "Agent used when none is selected",
      "type": "string"
    },
    "permission": {
      "default": {
        "edit": "ask",
        "write": "ask",
        "bash": "ask",
        "network": "ask",
        "delete": "ask",
        "mcp": "ask",
        "external_directory": "deny",
        "doom_loop": "ask",
        "allowlist": [],
        "rules": {}
      },
      "type": "object",
      "properties": {
        "edit": {
          "default": "ask",
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "write": {
          "default": "ask",
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "bash": {
          "default": "ask",
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "network": {
          "default": "ask",
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "delete": {
          "default": "ask",
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "mcp": {
          "default": "ask",
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "external_directory": {
          "default": "deny",
          "type": "string",
          "enum": [
            "deny",
            "ask",
            "allow"
          ]
        },
        "doom_loop": {
          "default": "ask",
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "allowlist": {
          "default": [],
          "description": "Command patterns that are always allowed, e.g. \"git *\"",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "default": {},
          "description": "Argument-level rules, e.g. {\"bash(git *)\": \"allow\"}. deny always wins; among ask and allow the most specific pattern wins.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "ask",
              "allow",
              "deny"
            ]
          }
        }
      },
      "description": "Deny by default. With no client connected, every ask becomes a deny."
    },
    "search": {
      "default": {
        "backend": "ddg"
      },
      "type": "object",
      "properties": {
        "backend": {
          "default": "ddg",
          "type": "string",
          "enum": [
            "ddg",
            "brave",
            "tavily"
          ]
        },
        "apiKey": {
          "description": "Required by brave and tavily. Prefer `${env:VAR_NAME}` over a literal.",
          "type": "string"
        }
      },
      "description": "Web search backend for the `websearch` tool"
    },
    "account": {
      "type": "object",
      "properties": {
        "server": {
          "description": "Base URL of the titah-web instance used for `titah login`. Overridden by $TITAH_ACCOUNT_SERVER.",
          "type": "string"
        }
      },
      "description": "Titah account (SSO) settings. The token itself lives in account.json, never here."
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "Checker to run, e.g. \"npm run typecheck\" or \"cargo clippy\""
        }
      },
      "required": [
        "command"
      ],
      "description": "Project checker for the `diagnostics` tool"
    },
    "mcp": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "description": "Executable that speaks MCP over stdio",
            "type": "string"
          },
          "args": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "url": {
            "description": "HTTP endpoint of a remote MCP server",
            "type": "string"
          },
          "headers": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "oauth": {
            "default": false,
            "type": "boolean"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          }
        }
      }
    },
    "lsp": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Language server binary, e.g. \"typescript-language-server\""
          },
          "args": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "File extensions it handles, e.g. [\".ts\", \".tsx\"]"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "format": {
            "default": true,
            "type": "boolean"
          },
          "tabSize": {
            "default": 2,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "insertSpaces": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "command",
          "extensions"
        ]
      }
    },
    "plugin": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "options": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          }
        }
      }
    },
    "delegation": {
      "default": "ask",
      "description": "When to hand work to sub-agents. ask: analyse after planning and ask you. auto: the model decides silently. always: hand over matching work. never: off.",
      "type": "string",
      "enum": [
        "ask",
        "auto",
        "always",
        "never"
      ]
    },
    "compaction": {
      "default": {
        "auto": true,
        "reserved": 8192,
        "tailTurns": 2,
        "prune": true
      },
      "type": "object",
      "properties": {
        "auto": {
          "default": true,
          "description": "Compact automatically when the context fills up",
          "type": "boolean"
        },
        "reserved": {
          "default": 8192,
          "description": "Tokens held back from the window for the next response and for the summarisation call. It does NOT cover the growth of the next step: one more tool result is budgeted separately, from the largest one seen so far in the running turn. Capped at a quarter of the window in use.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tailTurns": {
          "default": 2,
          "description": "Recent user turns kept verbatim, never summarised",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prune": {
          "default": true,
          "description": "Drop old tool output before summarising — free, and tool output is the bulk of it",
          "type": "boolean"
        }
      },
      "description": "Automatic context compaction. Requires contextWindow on the model in use."
    },
    "keybinds": {
      "default": {},
      "description": "TUI keybinding overrides, e.g. {\"session_interrupt\": \"ctrl+g\"}. Defaults follow opencode; \"none\" disables an action.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "instructions": {
      "description": "Extra instruction files, beyond AGENTS.md/CLAUDE.md/TITAH.md. A string, {\"path\": \"...\"}, or an array of either. Missing files are created on the first turn of a session.",
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ]
          }
        ]
      }
    },
    "limits": {
      "default": {
        "continueTurns": 0
      },
      "type": "object",
      "properties": {
        "turnTokens": {
          "description": "Token budget for one turn (input + output, summed across steps). Unset means no budget. Setting it also lifts the step ceiling to 200, since steps stop being the thing that bounds the turn.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sessionTokens": {
          "description": "Token budget for a whole session (input + output, summed across turns). Unset means no session budget. A turn that would start past it is refused.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "continueTurns": {
          "default": 0,
          "description": "How many times Titah may continue on its own after a turn stops at a limit, while the plan still has unchecked items. 0 disables it.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "scaffold": {
      "default": true,
      "description": "Create declared instruction files, skill folders, and a starter AGENTS.md on the first turn of a session. Set false to never write anything you did not ask for.",
      "type": "boolean"
    },
    "hooks": {
      "default": {
        "tool.before": [],
        "tool.after": []
      },
      "type": "object",
      "properties": {
        "tool.before": {
          "default": [],
          "description": "Run before a tool. A non-zero exit refuses the call; stderr is the reason.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "description": "Regex over the tool name. Omit to match all.",
                "type": "string"
              },
              "run": {
                "type": "string",
                "minLength": 1
              },
              "timeout": {
                "description": "ms, default 30000",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "run"
            ]
          }
        },
        "tool.after": {
          "default": [],
          "description": "Run after a tool. A non-zero exit does not undo anything, but its stderr is appended to the tool output so the model sees it.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "type": "string"
              },
              "run": {
                "type": "string",
                "minLength": 1
              },
              "timeout": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "run"
            ]
          }
        }
      }
    },
    "sandbox": {
      "default": {
        "bash": false,
        "network": true
      },
      "type": "object",
      "properties": {
        "bash": {
          "default": false,
          "description": "Run bash commands inside the OS sandbox: writes are confined to the project directory and temp. Refuses to run bash if no sandbox exists on this platform.",
          "type": "boolean"
        },
        "network": {
          "default": true,
          "description": "Allow network from inside the sandbox. npm and git need it.",
          "type": "boolean"
        }
      }
    },
    "tracking": {
      "default": {
        "enabled": true,
        "exclude": [],
        "git": true,
        "sync": false
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Report project metadata to your account dashboard. Nothing is ever sent when you are not signed in, whatever this says.",
          "type": "boolean"
        },
        "exclude": {
          "default": [],
          "description": "Project paths never reported, e.g. \"~/clients/*\". Same glob dialect as permission.allowlist; ~ is expanded first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "git": {
          "default": true,
          "description": "Include the git remote URL and branch. A remote URL often names a client, which leaks more than the folder name does.",
          "type": "boolean"
        },
        "sync": {
          "default": false,
          "description": "Upload session transcripts. Needs this AND the per-project toggle on the server. Prompts, answers, and tool NAMES only — never tool arguments or tool output, which is where secrets live.",
          "type": "boolean"
        }
      }
    },
    "logLevel": {
      "default": "INFO",
      "type": "string",
      "enum": [
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR"
      ]
    }
  }
}
